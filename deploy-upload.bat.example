@echo off
REM Copy this file to deploy-upload.bat and adjust KEY, TARGET, REMOTE_PATH below.
REM deploy-upload.bat is gitignored so your key path and host are not committed.
setlocal

cd /d "%~dp0"
if not exist deploy (
    echo deploy folder not found. Run build-deploy.bat first.
    exit /b 1
)

set "KEY=-i C:\Users\okayt\.ssh\synology_ds220"
set "TARGET=akumaadminchrome@192.168.1.170"
set "REMOTE_PATH=/web/vo2"
set "SSH_OPTS=-o PreferredAuthentications=publickey -o PasswordAuthentication=no"

REM Try SCP first
scp %SSH_OPTS% %KEY% -r deploy\* %TARGET%:%REMOTE_PATH%/
if %errorlevel% equ 0 goto :upload_done

REM Synology often has "subsystem request failed" for SCP; use SFTP instead
echo SCP failed, trying SFTP...
set "SFTP_SCRIPT=%TEMP%\sisu-trainer-deploy-sftp-%RANDOM%.txt"
(
  echo lcd deploy
  echo cd %REMOTE_PATH%
  echo put -r .
  echo quit
) > "%SFTP_SCRIPT%"
sftp %SSH_OPTS% %KEY% -b "%SFTP_SCRIPT%" %TARGET%
set "SFTP_ERR=%errorlevel%"
del "%SFTP_SCRIPT%" 2>nul
if %SFTP_ERR% neq 0 (
  echo NAS upload failed.
  exit /b 1
)

:upload_done
echo NAS upload done.
endlocal
